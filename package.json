{
  "name": "audio-word-cloud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "node server/app.js",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test:api": "npm --prefix server run test:api",
    "install-all": "npm install --prefix client && npm install --prefix server"
  }
}
